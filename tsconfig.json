{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.ts",
		"prettier.config.js",
		"eslint.config.js"
	]
}
